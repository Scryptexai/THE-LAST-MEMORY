; Engine configuration file.
; THE LAST MEMORY — "Life is Strange + Mystery" full game (Godot 4, GDScript)

config_version=5

[application]

config/name="THE LAST MEMORY"
config/description="Game naratif investigasi: seorang arsitek muda kembali ke Kota Tua Pesisir dan mengungkap rahasia kecelakaan kereta 40 tahun lalu."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.102, 0.212, 0.365, 1)
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://scripts/autoload/SignalBus.gd"
DataManager="*res://scripts/autoload/DataManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
RelationshipManager="*res://scripts/autoload/RelationshipManager.gd"
InvestigationManager="*res://scripts/autoload/InvestigationManager.gd"
DialogueManager="*res://scripts/autoload/DialogueManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"
PhotoManager="*res://scripts/autoload/PhotoManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

